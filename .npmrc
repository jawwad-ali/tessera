# Workspace packages are consumed as TypeScript source (see ARCHITECTURE.md §3),
# so they must resolve to the local checkout, never to a registry copy.
link-workspace-packages=true
prefer-workspace-packages=true

# Surface peer problems at install time. `yjs` is a peer of @tessera/crdt precisely
# so that a second copy in the tree is a loud install error rather than a silent
# `Unexpected content type` throw at runtime (ARCHITECTURE.md §3, invariant 2).
strict-peer-dependencies=true
resolution-mode=highest
